# ARCOS — Fichier de configuration des variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# IMPORTANT : Ne jamais committer .env (contient des secrets).
# Lancer le wizard de configuration : java -jar arcos.jar --setup

# ── Clés API (obligatoire) ────────────────────────────────────────────────────
# Mistral AI — LLM principal d'ARCOS (OBLIGATOIRE)
# Obtenir sur : https://console.mistral.ai/
MISTRALAI_API_KEY=

# ── Clés API (optionnelles) ───────────────────────────────────────────────────
# Brave Search — Recherche web (OPTIONNEL)
# Obtenir sur : https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=

# Picovoice Porcupine — Détection du mot de réveil (OPTIONNEL)
# Obtenir sur : https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=

# ── Configuration services (valeurs par défaut fonctionnelles) ────────────────
# Hôte et port de Qdrant (laisser vide pour utiliser localhost:6334)
QDRANT_HOST=localhost
QDRANT_PORT=6334

# Dimension des embeddings (doit correspondre au modèle utilisé)
EMBEDDING_DIMENSION=1024

# Identifiants CalDAV (Radicale). Défaut arcos/arcos — à changer si le
# calendrier est exposé (ex: via Tailscale) ; mettre à jour Radicale ET DAVx5.
ARCOS_CALDAV_USERNAME=arcos
ARCOS_CALDAV_PASSWORD=arcos
